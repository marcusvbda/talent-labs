APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"


OPENAI_API_KEY=XXX

REVERB_APP_ID=XXX
REVERB_APP_KEY=XXX
REVERB_APP_SECRET=XXXX
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

FILAMENT_REALTIME_SERVER=localhost:8080

# Local seed users (db:seed)
SEED_ADMIN_NAME="xxxx"
SEED_ADMIN_EMAIL=xxx@xxxx.com
SEED_ADMIN_PASSWORD=xxxx
SEED_CLIENT_NAME="xxxx"
SEED_CLIENT_EMAIL=xxx@xxxx.com
SEED_CLIENT_PASSWORD=XXXX

CONTACTS_SMTP_HELO=
CONTACTS_SMTP_MAIL_FROM=

# Gmail sending (per client). Google Cloud Console: create a project, enable
# the Gmail API, OAuth consent screen in "Testing" with your test users added
# (refresh tokens expire after 7 days in Testing), then create an OAuth client
# of type "Web application" with redirect URI {APP_URL}/integrations/oauth/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/integrations/oauth/callback"

# Test mode for application emails. When set, every application email is delivered to this
# address instead of the company (subject prefixed with the real recipient). Empty/unset =
# emails go to the companies for real.
OUTREACH_INTERCEPT_TO=

# Keep APP_NAME in sync with BRAND_NAME manually.
BRAND_NAME="Talent Labs"
BRAND_WORDMARK_REGULAR=Talent
BRAND_WORDMARK_BOLD=Labs
VITE_USE_FIXTURES=true
