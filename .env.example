APP_NAME=TalentLabs
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

RESEND_API_KEY=XXXX
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"


OPENAI_API_KEY=XXX

REVERB_APP_ID=XXX
REVERB_APP_KEY=XXX
REVERB_APP_SECRET=XXXX
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

FILAMENT_REALTIME_SERVER=localhost:8080

# Local seed users (db:seed)
SEED_ADMIN_NAME="xxxx"
SEED_ADMIN_EMAIL=xxx@xxxx.com
SEED_ADMIN_PASSWORD=xxxx
SEED_CLIENT_NAME="xxxx"
SEED_CLIENT_EMAIL=xxx@xxxx.com
SEED_CLIENT_PASSWORD=XXXX

CONTACTS_SMTP_HELO=
CONTACTS_SMTP_MAIL_FROM=

# Gmail sending (per client). Google Cloud Console: create a project, enable
# the Gmail API, OAuth consent screen in "Testing" with your test users added
# (refresh tokens expire after 7 days in Testing), then create an OAuth client
# of type "Web application" with redirect URI {APP_URL}/integrations/oauth/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/integrations/oauth/callback"

# Test mode for application emails. When set, every application email is delivered to this
# address instead of the company (subject prefixed with the real recipient). Empty/unset =
# emails go to the companies for real.
OUTREACH_INTERCEPT_TO=
OUTREACH_SEND_INTERVAL_MIN_SECONDS=45
OUTREACH_SEND_INTERVAL_MAX_SECONDS=120
OUTREACH_STEP_DELAY_MS=1200
OUTREACH_WINDOW_ENABLED=false
OUTREACH_WINDOW_START=08:00
OUTREACH_WINDOW_END=19:00
OUTREACH_WINDOW_WEEKDAYS_ONLY=true
OUTREACH_AUTO_PAUSE_AFTER_FAILURES=3

# Keep APP_NAME in sync with BRAND_NAME manually.
BRAND_NAME="Talent Labs"
BRAND_WORDMARK_REGULAR=Talent
BRAND_WORDMARK_BOLD=Labs
VITE_USE_FIXTURES=true

PLAN_DEFAULT=free
PLAN_FREE_DAILY_LIMIT=25
PLAN_STARTER_DAILY_LIMIT=50
PLAN_PRO_DAILY_LIMIT=150
INVITE_EXPIRY_DAYS=14
MATCHING_UNKNOWN_SENIORITY_PASSES=true

# Billing. Displayed prices come from PRICE_*; charged prices come from the Stripe Price IDs.
# Keep them equal. A price of 0 means the plan is free in that region (no Checkout).
BILLING_ENABLED=false
PLAN_HIGHLIGHTED=starter
PLANS_CONTACT_EMAIL=
PRICE_FREE_BRL=2500
PRICE_FREE_EUR=500
PRICE_FREE_USD=500
PRICE_STARTER_BRL=5000
PRICE_STARTER_EUR=900
PRICE_STARTER_USD=1000
PRICE_PRO_BRL=10000
PRICE_PRO_EUR=1900
PRICE_PRO_USD=2000
STRIPE_PRICE_FREE_BRL=
STRIPE_PRICE_FREE_EUR=
STRIPE_PRICE_FREE_USD=
STRIPE_PRICE_STARTER_BRL=
STRIPE_PRICE_STARTER_EUR=
STRIPE_PRICE_STARTER_USD=
STRIPE_PRICE_PRO_BRL=
STRIPE_PRICE_PRO_EUR=
STRIPE_PRICE_PRO_USD=

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
# stripe listen --events customer.subscription.created,customer.subscription.updated,customer.subscription.deleted,invoice.payment_failed,invoice.payment_action_required,customer.updated,customer.deleted --forward-to http://localhost:8000/stripe/webhook


ADZUNA_APP_ID=*****
ADZUNA_APP_KEY=******
LANDING_BETA_CLOSED=true
LANDING_PRICES_ILLUSTRATIVE=true
TALENT_CONTACT_EMAIL=
